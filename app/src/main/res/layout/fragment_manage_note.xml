<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".presentation.ui.manage.base.BaseManageNoteFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12sp"
        android:orientation="horizontal"
        android:theme="@style/TopAppBarBackgroundColor"
        >
        <!--        placeholder       -->
        <Space
            android:layout_width="0sp"
            android:layout_height="50sp"
            app:shapeAppearanceOverlay="@style/roundedImageView"
            android:padding="4sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center|center"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@string/manage_task_placeholder"
            android:id="@+id/manageTaskTopText"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="2sp"
            android:text="@string/task_title"/>
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_bg"
            android:hint="@string/task_title"
            android:padding="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="2sp"
            android:text="@string/task_description"/>
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_bg"
            android:hint="@string/task_description"
            android:lines="5"
            android:gravity="start"
            android:padding="12sp"/>
    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">
        <View
            android:id="@+id/colorBox1"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@color/green"
            android:layout_marginHorizontal="8dp"/>

        <View
            android:id="@+id/colorBox2"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@color/cyan"
            android:layout_marginHorizontal="8dp"/>

        <View
            android:id="@+id/colorBox3"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@color/red"
            android:layout_marginHorizontal="8dp"/>

        <View
            android:id="@+id/colorBox4"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@color/purple"
            android:layout_marginHorizontal="8dp"/>

        <View
            android:id="@+id/colorBox5"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@color/yellow"
            android:layout_marginHorizontal="8dp"/>

    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/submitTaskText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/submit_task_placeholder"
        app:iconGravity="textStart"
        android:textAllCaps="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:cornerRadius="8dp"
        android:layout_marginBottom="12sp"/>
</LinearLayout>